 src/core/n64video/rdp.c            |  13 ++
 src/core/n64video/rdp/rasterizer.c | 201 +++++++++++++++++++++++++++++
 src/core/parallel.cpp              |  25 ++++
 src/core/parallel.h                |  10 ++
 5 files changed, 260 insertions(+)

