From 7b7604749e3568f06c797db1c2211f2b1af87d12 Mon Sep 17 00:00:00 2001
From: Nekokabu <nekokabu@gmail.com>
Date: Sun, 25 Oct 2026 16:19:05 +0900
Subject: [PATCH] Emulate the RDP load hazard (pending TMEM writes after a
 load)

On real hardware the last TMEM writes of Load_Tile, Load_Block and
Load_TLUT are still pending when the next command arrives. A Set_Tile or
Set_Texture_Image sent soon after the load, with no sync in between,
changes where those writes go or which RDRAM rows they read.

Measured on NTSC and PAL consoles (identical, deterministic) with the
rdp_load_hazard test ROMs:

- The last 15 slots of a load stay queued. One slot is one iteration of
  the loading pipeline (8 source bytes, or one Load_TLUT entry). Each
  row takes max(words + 1, 9) slots; the slots before its words write
  nothing.
- Every command that only sets state retires one slot, after its own
  state change, so the write uses the tile descriptor of that moment.
- Syncs, drawing commands and loads complete the whole queue first. So
  does an idle RDP, about 30 us after it runs out of commands; this is
  approximated by completing the queue whenever the command list ends.
- Set_Texture_Image moves a row to the new address if it arrives before
  the row's source address is fixed. That slot depends on the RDRAM
  alignment of the previous row.

The queue is kept per worker, so parallel mode behaves the same.
---
 src/core/n64video.c         |  41 +++-
 src/core/n64video/rdp.c     |  43 ++++
 src/core/n64video/rdp/tex.c | 473 +++++++++++++++++++++++-------------
 3 files changed, 381 insertions(+), 176 deletions(-)

diff --git a/src/core/n64video.c b/src/core/n64video.c
index b5f8e3b..376a56c 100644
--- a/src/core/n64video.c
+++ b/src/core/n64video.c
@@ -126,11 +126,18 @@ static uint32_t rdp_cmd_len;
 // multithreaded mode
 static bool rdp_cmd_sync[64];
 
+// buffer entries that mark the end of the available commands (RDP idle)
+static bool rdp_cmd_idle[CMD_BUFFER_SIZE];
+
 static void cmd_run_buffered(uint32_t worker_id)
 {
     uint32_t pos;
     for (pos = 0; pos < rdp_cmd_buf_pos; pos++) {
-        rdp_cmd(&state[worker_id], rdp_cmd_buf[pos]);
+        if (rdp_cmd_idle[pos]) {
+            rdp_idle(&state[worker_id]);
+        } else {
+            rdp_cmd(&state[worker_id], rdp_cmd_buf[pos]);
+        }
     }
 }
 
@@ -145,6 +152,30 @@ static void cmd_flush(void)
     }
 }
 
+// tell the workers that the RDP has run out of commands
+static void cmd_idle(void)
+{
+    if (!config.parallel) {
+        rdp_idle(&state[0]);
+        return;
+    }
+
+    // a partially received command still occupies the current entry
+    if (rdp_cmd_pos != 0) {
+        return;
+    }
+
+    // one marker is enough
+    if (rdp_cmd_buf_pos > 0 && rdp_cmd_idle[rdp_cmd_buf_pos - 1]) {
+        return;
+    }
+
+    rdp_cmd_idle[rdp_cmd_buf_pos++] = true;
+    if (rdp_cmd_buf_pos >= CMD_BUFFER_SIZE) {
+        cmd_flush();
+    }
+}
+
 static void cmd_init(void)
 {
     rdp_cmd_pos = 0;
@@ -281,13 +312,16 @@ void n64video_process_list(void)
             if (config.parallel) {
                 // special case: sync_full always needs to be run in main thread
                 if (rdp_cmd_id == CMD_ID_SYNC_FULL) {
-                    // first, run all pending commands
+                    // first, run all pending commands, including the queued
+                    // TMEM writes that the sync completes
+                    cmd_idle();
                     cmd_flush();
 
                     // parameters are unused, so NULL is fine
                     rdp_sync_full(NULL, NULL);
                 } else {
                     // increment buffer position
+                    rdp_cmd_idle[rdp_cmd_buf_pos] = false;
                     rdp_cmd_buf_pos++;
 
                     // flush buffer when it is full or when the current command requires a sync
@@ -310,6 +344,9 @@ void n64video_process_list(void)
         }
     }
 
+    // the RDP is now idle until more commands arrive
+    cmd_idle();
+
     // update DP registers to indicate that all bytes have been read
     *dp_reg[DP_START] = *dp_reg[DP_CURRENT] = *dp_reg[DP_END];
 }
