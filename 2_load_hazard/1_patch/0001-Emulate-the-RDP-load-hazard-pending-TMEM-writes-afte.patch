+        || cmd_id == CMD_ID_LOAD_TLUT || cmd_id == CMD_ID_LOAD_BLOCK || cmd_id == CMD_ID_LOAD_TILE
+        || cmd_id == CMD_ID_FILL_RECTANGLE;
+}
