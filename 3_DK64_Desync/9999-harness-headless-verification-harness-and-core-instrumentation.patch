+  if(op == 0x10 && ((instruction >> 21 & 31) == 4 || (instruction >> 21 & 31) == 5)) cycles += 1;  //MTC0/DMTC0 cost 2 (v14)
   if(!next) return cycles;
   auto nop = next >> 26;
