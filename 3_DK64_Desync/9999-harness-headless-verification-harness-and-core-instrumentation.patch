+        FILE* f = fopen(string{dir, "/", name}, "wb"); if(f) { fwrite(buf.data(), 1, size, f); fclose(f); }
+      };
+      dump("rdram.bin", [&](u32 a) { return (u32)rdram.ram.readUnaligned<Word>(a); }, rdram.ram.size);
+      dump("dmem.bin", [&](u32 a) { return dmem.read<Word>(a); }, 4096);
+      dump("imem.bin", [&](u32 a) { return imem.read<Word>(a); }, 4096);
+      FILE* f = fopen(string{dir, "/meta.txt"}, "w");
+      if(f) {
+        Thread dummy{};
+        fprintf(f, "gfx_task %u\ntask %u\nrdram_size %u\nsp_pc %08x\n", harnessGfxTaskCount, harnessTaskCount, rdram.ram.size, ipu.pc);
+        for(u32 r = 0; r < 14; r++) fprintf(f, "vi%u %08x\n", r, vi.readWord(0x04400000 + r * 4, dummy));
+        fprintf(f, "dpc_start %08x\ndpc_end %08x\ndpc_current %08x\ndpc_status %08x\n", rdp.command.start, rdp.command.end, rdp.command.current, rdp.readWord(0x0410000c, dummy));
+        for(u32 w = 0; w < 16; w++) fprintf(f, "task%u %08x\n", w, dmem.read<Word>(0xfc0 + w * 4));
+        fclose(f);
+      }
+      fprintf(stderr, "DUMP task gfx#%u -> %s\n", harnessGfxTaskCount, (const char*)dir);
+    }
+  }
+}
+
+auto RSP::harnessTaskEnd() -> void {
+  static const char* logEnv = getenv("ARES_TASK_LOG");
+  if(logEnv) fprintf(stderr, "TASK end #%u clock %lld (+%lld) vi %llu sync %llu pending %llu\n", harnessTaskCount, (long long)cpu.busNow(), (long long)(cpu.busNow() - harnessTaskClock),
+    (unsigned long long)vi.harnessFrames, (unsigned long long)rdp.timing.syncFullCount, (unsigned long long)rdp.timing.pending);
+}
